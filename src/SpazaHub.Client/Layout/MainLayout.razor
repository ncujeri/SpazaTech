@inherits LayoutComponentBase

<div class="app-shell">
    <header class="brand-bar">
        <span class="brand-mark">Spaza<span class="brand-hub">Hub</span></span>
    </header>

    <main class="app-main">
        @Body
    </main>

    <nav class="tab-bar" aria-label="Main">
        <NavLink class="tab" href="pos">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v6H4z M4 13h16v7H4z M8 16h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span>Sell</span>
        </NavLink>
        <NavLink class="tab" href="cashback">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12.5" r="2.6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <span>Cashback</span>
        </NavLink>
        <NavLink class="tab" href="cashup">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h16v9H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 10V6h8v4 M10 14h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span>Cash-up</span>
        </NavLink>
        <NavLink class="tab" href="report">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10 M12 20V4 M19 20v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <span>Report</span>
        </NavLink>
        <NavLink class="tab" href="products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4v10l-8 4-8-4V7z M12 3v18 M4 7l8 4 8-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span>Stock</span>
        </NavLink>
    </nav>
</div>
